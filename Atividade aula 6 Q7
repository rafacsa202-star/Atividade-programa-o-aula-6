soma = 0
quantidade = 0

while True:
    nota = float(input("Digite uma nota (-1 para encerrar): "))
    
    if nota == -1:
        break
    
    if nota >= 0:
        soma += nota
        quantidade += 1
    else:
        print("Nota inválida. Digite uma nota válida.")

if quantidade > 0:
    media = soma / quantidade
    print("Média das notas:", media)
else:
    print("Nenhuma nota válida foi digitada.")
