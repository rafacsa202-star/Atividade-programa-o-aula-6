positivos = 0
negativos = 0

while True:
    numero = float(input("Digite um número (0 para encerrar): "))
    
    if numero == 0:
        break
    
    if numero > 0:
        positivos += 1
    else:
        negativos += 1

print("Quantidade de números positivos:", positivos)
print("Quantidade de números negativos:", negativos)
